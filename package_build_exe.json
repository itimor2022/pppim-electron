{
  "name": "享聊",
  "version": "3.3.0",
  "main": "dist-electron/main/index.js",
  "description": "享聊 PC 客户端.",
  "author": "blooming",
  "private": true,
  "debug": {
    "env": {
      "VITE_DEV_SERVER_URL": "http://127.0.0.1:7777/"
    }
  },
  "scripts": {
    "dev": "vite --host",
    "build": "tsc && vite build && electron-builder",
    "preview": "vite preview",
    "build:mac": "vite build  &&  electron-builder --macos --x64",
    "build:mac-arm": "vite build  &&  electron-builder --macos --arm64",
    "build:win": "vite build  &&  electron-builder --win --x64",
    "build:win-arm": "vite build  &&  electron-builder --win --arm64",
    "build:linux": "vite build  &&  electron-builder --linux --x64",
    "build:linux-arm": "vite build  &&  electron-builder --linux --arm64",
    "generate-icons": "node generate_icons_simple.js",
    "generate-icons-advanced": "node generate_icons.js",
    "pree2e": "vite build --mode=test",
    "e2e": "playwright test",
    "format": "prettier --write .",
    "lint": "eslint --ext .js,.jsx,.ts,.tsx src",
    "lint:fix": "eslint --ext .js,.jsx,.ts,.tsx --fix --quiet src"
  },
  "engines": {
    "node": "^14.18.0 || >=16.0.0"
  },
  "build": {
    "extends": null,
    "files": ["dist/**/*", "dist-electron/**/*"],
    "directories": {
      "output": "package"
    },
    "productName": "享聊",
    "win": {
      "icon": "./dist/icons/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "mac": {
      "icon": "./dist/icons/icon.png"
    },
    "linux": {
      "icon": "./dist/icons/icon.png",
      "target": "deb",
      "maintainer": "openim-cer"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": true,
      "shortcutName": "享聊",
      "installerIcon": "./dist/icons/icon.ico",
      "uninstallerIcon": "./dist/icons/icon.ico",
      "installerHeaderIcon": "./dist/icons/icon.ico"
    },
    "asar": true,
    "extraResources": {
      "from": "./extraResources/",
      "to": "extraResources"
    }
  },
  "lint-staged": {
    "src/**/*.{tsx,ts}": ["prettier --write", "eslint --fix"],
    "*.{json,html,css,scss,xml,md}": ["prettier --write"]
  },
  "devDependencies": {
    "@types/md5": "^2.3.2",
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.11",
    "@types/uuid": "^9.0.1",
    "@typescript-eslint/eslint-plugin": "^5.53.0",
    "@typescript-eslint/parser": "^5.53.0",
    "@vitejs/plugin-legacy": "^4.1.0",
    "@vitejs/plugin-react": "^3.1.0",
    "autoprefixer": "^10.4.13",
    "electron": "^22.3.27",
    "electron-builder": "^23.6.0",
    "eslint": "^8.34.0",
    "eslint-config-prettier": "^8.6.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-simple-import-sort": "^10.0.0",
    "lint-staged": "^13.1.2",
    "patch-package": "^8.0.0",
    "postcss": "^8.4.21",
    "prettier": "^2.8.4",
    "prettier-plugin-tailwindcss": "^0.2.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rollup-plugin-visualizer": "^5.9.2",
    "sass": "^1.58.3",
    "tailwindcss": "^3.2.7",
    "terser": "^5.19.0",
    "typescript": "^4.9.5",
    "vite": "^4.1.4",
    "vite-electron-plugin": "^0.8.2",
    "vite-plugin-electron": "^0.11.1"
  },
  "dependencies": {
    "@ant-design/icons": "^5.1.4",
    "@livekit/components-react": "^1.4.2",
    "@livekit/components-styles": "^1.0.7",
    "@tailwindcss/line-clamp": "^0.4.4",
    "adm-zip": "^0.5.10",
    "ahooks": "^3.7.7",
    "antd": "^5.6.0",
    "axios": "^1.4.0",
    "clsx": "^1.2.1",
    "date-fns": "^2.30.0",
    "dayjs": "^1.11.7",
    "electron-log": "^5.0.0",
    "electron-screenshots": "^0.5.23",
    "electron-store": "^8.1.0",
    "electron-updater": "^5.3.0",
    "emoji-picker-element": "^1.18.3",
    "i18next": "^22.5.0",
    "i18next-browser-languagedetector": "^7.0.2",
    "i18next-fs-backend": "^2.2.0",
    "livekit-client": "^1.15.2",
    "localforage": "^1.10.0",
    "md5": "^2.3.0",
    "mitt": "^3.0.0",
    "open-im-sdk-wasm": "^3.5.1-alpha.3",
    "react-draggable": "^4.4.5",
    "react-i18next": "^12.3.1",
    "react-image-file-resizer": "^0.4.8",
    "react-infinite-scroll-component-two-way": "^6.1.1",
    "react-query": "^3.39.3",
    "react-router-dom": "^6.11.1",
    "react-use": "^17.4.0",
    "react-virtuoso": "^4.3.8",
    "sudo-prompt": "^9.2.1",
    "twemoji": "14.0.1",
    "uuid": "^9.0.1",
    "xgplayer": "^3.0.5",
    "zustand": "^4.3.3"
  }
}
